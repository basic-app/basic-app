{
    "name": "basic-app/basic-app",
    "description": "Basic App demo app",
    "license": "MIT",
    "type": "project",
    "homepage": "https://basic-app.com",
    "support": {
        "forum": "https://forum.codeigniter.com/thread-73103.html",
        "source": "https://github.com/basic-app/basic-app"
    },
    "require": {
        "php": "^8.2",
        "codeigniter4/framework": "^4.7",
        "basic-app/admin": "dev-master",
        "basic-app/adminlte4": "dev-main",
        "basic-app/jquery3": "dev-main",
        "basic-app/lightbox2": "dev-main",
        "basic-app/site": "dev-master",
        "basic-app/site-landing": "dev-main",
        "basic-app/site-landing-sb": "dev-main",
        "basic-app/tinymce7": "dev-main"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9",
        "mikey179/vfsstream": "^1.6",
        "phpunit/phpunit": "^10.5.16",
        "codeigniter4/translations" : "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/_support"
        }
    },
    "config": {
        "optimize-autoloader": false,
        "preferred-install": "dist",
        "sort-packages": false
    },
    "extra": {
        "BasicApp\\Core\\Composer::postCreateProject": {
            "copy": [
                {
                    "env": ".env",
                    "environment/public/robots.txt": "public/robots.txt",
                    "environment/public/favicon.ico": "public/favicon.ico"                    
                }
            ],
            "setPermission": [
                {
                    "writable/cache": "0755",
                    "writable/debugbar": "0755",
                    "writable/logs": "0755",
                    "writable/session": "0755",
                    "writable/uploads": "0755"
                }
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "post-create-project-cmd": [
            "BasicApp\\Core\\Composer::postCreateProject"
        ],
        "post-install-cmd": [
            "@composer dump-autoload",
            "BasicApp\\Core\\Composer::postInstall"
        ],
        "post-update-cmd": [
            "@composer dump-autoload",
            "BasicApp\\Core\\Composer::postUpdate"
        ]
    }
}
